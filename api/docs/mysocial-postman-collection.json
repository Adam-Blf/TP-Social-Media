          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "const photos = pm.response.json().photos;",
                  "const last = photos[photos.length - 1];",
                  "pm.environment.set('photoId', last.id);
