            },
            "url": { "raw": "{{baseUrl}}/groups", "host": ["{{baseUrl}}"], "path": ["groups"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "pm.environment.set('groupId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Lister groupes",
          "request": {
            "method": "GET",
