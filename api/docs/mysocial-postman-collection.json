    {
      "name": "04 - Événements",
      "item": [
        {
          "name": "Créer événement via groupe",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Soirée lancement\",\n  \"description\": \"Présentation produit\",\n  \"startDate\": \"2025-12-01T18:00:00.000Z\",\n  \"endDate\": \"2025-12-01T22:00:00.000Z\",\n  \"location\": \"Paris\",\n  \"createdBy\": \"{{userAdminId}}\",\n  \"organizers\": [\"{{userAdminId}}\"],\n  \"settings\": {\n    \"shoppingListEnabled\": true,\n    \"carpoolingEnabled\": true,\n    \"ticketingEnabled\": true\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/groups/{{groupId}}/events",
              "host": ["{{baseUrl}}"],
              "path": ["groups", "{{groupId}}", "events"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "pm.environment.set('eventId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ajouter participant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": \"{{userMemberId}}\",\n  \"status\": \"going\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/participants",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{eventId}}", "participants"]
            }
          }
        },
        {
          "name": "Consulter événement",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["events", "{{eventId}}"] }
          }
        }
      ]
    },
    {
      "name": "05 - Sondages",
      "item": [
        {
          "name": "Créer sondage",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Choix traiteur\",\n  \"createdBy\": \"{{userAdminId}}\",\n  \"questions\": [\n    {\n      \"text\": \"Menu préfér��\",\n      \"options\": [ { \"label\": \"Buffet\" }, { \"label\": \"Tapas\" } ]\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}/polls", "host": ["{{baseUrl}}"], "path": ["events", "{{eventId}}", "polls"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.environment.set('pollId', r.id);",
                  "pm.environment.set('pollQuestionId', r.questions[0].id);",
                  "pm.environment.set('pollOptionId', r.questions[0].options[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Répondre au sondage",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"respondent\": \"{{userMemberId}}\",\n  \"answers\": [\n    {\n      \"questionId\": \"{{pollQuestionId}}\",\n      \"optionId\": \"{{pollOptionId}}\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/polls/{{pollId}}/responses",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{eventId}}", "polls", "{{pollId}}", "responses"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "pm.environment.set('pollResponseId', pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },
