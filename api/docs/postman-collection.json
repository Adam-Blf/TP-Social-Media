    {
      "name": "11 - Créer un sondage",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Choix du traiteur\",\n  \"description\": \"Vote pour le menu du lancement\",\n  \"createdBy\": \"{{userAdminId}}\",\n  \"questions\": [\n    {\n      \"text\": \"Menu préféré\",\n      \"options\": [\n        { \"label\": \"Buffet froid\" },\n        { \"label\": \"Tapas\" },\n        { \"label\": \"Street food\" }\n      ]\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/events/{{eventId}}/polls",
          "host": ["{{baseUrl}}"],
          "path": ["events", "{{eventId}}", "polls"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "let json = {};",
              "try { json = pm.response.json(); } catch (e) {};",
              "const pollId = json.id || json._id;",
              "if (pollId) { pm.environment.set('pollId', pollId); }",
              "if (json.questions && json.questions.length) {",
              "  const q = json.questions[0];",
              "  const qId = q.id || q._id;",
              "  if (qId) { pm.environment.set('pollQuestionId', qId); }",
              "  if (q.options && q.options.length) {",
              "    const opt = q.options[0];",
              "    const optId = opt.id || opt._id;",
              "    if (optId) { pm.environment.set('pollOptionId', optId); }",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
