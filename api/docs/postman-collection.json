          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"author\": \"{{userMemberId}}\",\n  \"content\": \"Hâte d'y être !\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/events/{{eventId}}/discussions/{{discussionThreadId}}/messages",
          "host": ["{{baseUrl}}"],
          "path": ["events", "{{eventId}}", "discussions", "{{discussionThreadId}}", "messages"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "let json = {};",
              "try { json = pm.response.json(); } catch (e) {};",
              "if (json && Array.isArray(json.messages) && json.messages.length) {",
              "  const message = json.messages[json.messages.length - 1];",
              "  const mid = message && (message.id || message._id);",
              "  if (mid) { pm.environment.set('discussionMessageId', mid); }",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
